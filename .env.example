# ─── Contact form (Resend) ─────────────────────────────────────────────
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=[EMAIL_ADDRESS]

# Sender address. "onboarding@resend.dev" works without a domain, but Resend
# then only delivers to the email that owns the Resend account.
# Once you verify your own domain in Resend, change this to e.g. hello@yourdomain.com
CONTACT_FROM_EMAIL=

# ─── Site ──────────────────────────────────────────────────────────────
# Optional override of the canonical URL (defaults to src/content/site.ts)
NEXT_PUBLIC_SITE_URL=
